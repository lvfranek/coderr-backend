# Copy this file to ".env" and fill in real values. The .env file is
# git-ignored and must never be committed.
#
# Generate a fresh secret key with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"

# Required. Django cryptographic signing key.
DJANGO_SECRET_KEY=replace-me-with-a-generated-key

# Optional. "True" only for local development, never in production.
DJANGO_DEBUG=False

# Optional. Comma-separated hostnames Django will serve.
# Required (non-empty) when DJANGO_DEBUG=False.
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
